# OPTIONAL overrides for selfhost-shape local dev (local auth, billing off).
# You do not need to copy this: `make dev-selfhost` (here or in the workspace)
# creates .env.local-selfhost from it when missing, and bare `mix phx.server`
# already defaults to the stores below (config/runtime.exs, MIX_ENV=dev).
# Edit .env.local-selfhost only to point somewhere else.
#
# Needs nothing outside your machine except an embedder for search (a local
# Ollama, or a Voyage API key). Postgres and Qdrant come from docker-compose.dev.yml
# (`make dev-db-up`: Postgres on localhost:5433, Qdrant on localhost:6334).
#
# Format: the Makefile feeds this file through `grep | xargs`, so use
# KEY=value lines and full-line comments only. No quotes, no spaces in values,
# no comments after a value. Leave an optional key commented out rather than
# empty: an empty value is still "set".

# --- Stores (docker-compose.dev.yml) ----------------------------------------
DATABASE_URL=postgresql://engram:engram@localhost:5433/engram_dev
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=engram_dev
# Binary quantization needs an AVX2 CPU; without it Qdrant dies with SIGILL.
# See docs/context/local-qdrant-sigill-no-avx2.md.
# QDRANT_BINARY_QUANTIZATION=false
# Attachments in Postgres, so no MinIO is needed.
STORAGE_BACKEND=database

# --- App --------------------------------------------------------------------
PORT=4000
AUTH_PROVIDER=local
# Dev only: anyone can register, so you can create test users freely.
ENGRAM_DEFAULT_REGISTRATION_MODE=open
KEY_PROVIDER=local
# Unset = the public DEV-ONLY key (Engram.RuntimeConfig.dev_encryption_master_key/0;
# prod refuses it). Set your own with `openssl rand -base64 32` if you like. A
# dev DB mints its boot canary under the first key it sees; changing it later
# means `make dev-db-reset`.
# ENCRYPTION_MASTER_KEY=

# --- Embeddings: pick ONE ---------------------------------------------------
# Option A: Ollama, no API key. Run Ollama anywhere you can reach, then
# `ollama pull mxbai-embed-large`. CPU is fine for a dev vault.
EMBED_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large
EMBED_DIMS=1024

# Option B: Voyage AI with your own key (comment out Option A).
# EMBED_BACKEND=voyage
# VOYAGE_API_KEY=pa-your-key
# EMBED_MODEL=voyage-4-large
# EMBED_DIMS=1024
# DOC_EMBED_MODEL=voyage-4-large
# QUERY_EMBED_MODEL=voyage-4-lite
