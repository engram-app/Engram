{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!public",
			"!**/playwright-report",
			"!**/test-results",
			"!bun.lock",
			"!**/*.md"
		]
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": {
							"level": "error",
							"options": {
								"inputComponents": ["Checkbox", "Input", "RadioGroupItem", "Textarea"]
							}
						}
					},
					"complexity": {
						"noExcessiveLinesPerFunction": "off",
						"useMaxParams": "off",
						"noExcessiveCognitiveComplexity": "off",
						"noForEach": "off",
						"useRegexpTest": "off"
					},
					"correctness": {
						"useQwikValidLexicalScope": "off",
						"noSolidDestructuredProps": "off",
						"noInvalidPositionAtImportRule": "off",
						"noUndeclaredDependencies": "off",
						"useImageSize": "off",
						"useUniqueElementIds": "off",
						"noReactNativeRawText": "off",
						"noComponentHookFactories": "off"
					},
					"nursery": {
						"noArrayForEach": "off",
						"noChainedComparison": "off",
						"noDanglingUnderscore": "off",
						"noDynamicDelete": "off",
						"noEagerArrayMethodsInLoops": "off",
						"noExcessiveNestedBlocks": "off",
						"noExcessiveStatementsPerFunction": "off",
						"noMapSpread": "off",
						"noNestedTemplateLiterals": "off",
						"noNull": "off",
						"noPlaywrightNthMethods": "off",
						"noProcessExit": "off",
						"noPromiseExecutorReturn": "off",
						"noReturnArrayPush": "off",
						"noSyncMethods": "off",
						"noTailwindLegacyUtilities": "off",
						"noTailwindRestyledComponents": "off",
						"noUnreadableForOfExpression": "off",
						"noUselessRecursion": "off",
						"noUselessSplice": "off",
						"useBlockStatementOverIife": "off",
						"useCapitalizedConstructors": "off",
						"useConsistentLightnessNotation": "off",
						"useExpectToContain": "off",
						"useFencedCodeLanguage": "off",
						"useLowercaseTestTitle": "off",
						"useNamedFunction": "off",
						"useSimplifiedBooleanReturn": "off",
						"useTailwindSortedClasses": "off",
						"useTailwindStaticClassStrings": "off",
						"useTailwindVariablesShorthand": "off",
						"useTanstackQueryStableQueryClient": "off",
						"useExplicitType": "off",
						"useExplicitReturnType": "off",
						"noThisOutsideOfClass": "off",
						"useReactNamingConvention": "off",
						"noTailwindArbitraryValue": "off",
						"noTailwindRawColors": "off",
						"useConsistentFunctionStyle": "off",
						"useLogicalProperties": "off",
						"useReactFunctionComponentDefinition": "off",
						"useValidTestTitle": "off"
					},
					"performance": {
						"useTopLevelRegex": "off",
						"useSolidForComponent": "off",
						"noImgElement": "off",
						"noJsxPropsBind": "off",
						"noAwaitInLoops": "off",
						"noBarrelFile": "off",
						"noNamespaceImport": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off",
						"noSecrets": "off"
					},
					"style": {
						"useNamingConvention": "off",
						"noMagicNumbers": "off",
						"noDefaultExport": "off",
						"noImplicitBoolean": "off",
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"sonner": {
										"importNames": ["toast"],
										"message": "Use notify() from @/lib/notify: it only accepts translated text (UIText)."
									}
								}
							}
						},
						"noJsxLiterals": {
							"level": "error",
							"options": {
								"allowedStrings": [
									"&nbsp;",
									"·",
									"••••",
									"&#10003;",
									"−",
									"/",
									"&times;",
									"×",
									"↗",
									"↳",
									"?",
									"#",
									"---",
									"x",
									"H",
									"404",
									".md",
									"type",
									"Engram",
									"Engram Vault Sync",
									"AMEX",
									"PayPal",
									"GPay",
									"github.com/engram-app/Engram",
									"support@engram.page",
									"ENGRAM_TELEMETRY=false",
									"engram_••••••"
								]
							}
						},
						"noTernary": "off",
						"noHexColors": "off",
						"useGlobalThis": "off",
						"noContinue": "off",
						"noExcessiveClassesPerFile": "off",
						"noExcessiveLinesPerFile": "off",
						"noExportedImports": "off",
						"noIncrementDecrement": "off",
						"noNestedTernary": "off",
						"noNonNullAssertion": "off",
						"noParameterProperties": "off",
						"useComponentExportOnlyModules": "off",
						"useConsistentMemberAccessibility": "off",
						"useConsistentMethodSignatures": "off",
						"noInlineStyles": "off",
						"useDomQuerySelector": "off",
						"useTestHooksOnTop": "off",
						"useThisInClassMethods": "off",
						"useUnicodeRegex": "off"
					},
					"suspicious": {
						"noReactSpecificProps": "off",
						"noAlert": "off",
						"noConsole": {
							"level": "error",
							"options": { "allow": ["error", "warn"] }
						},
						"noSkippedTests": "off",
						"noUnnecessaryConditions": "off",
						"noConditionalExpect": "off",
						"noDuplicateSelectors": "off",
						"useBaseline": "off",
						"useExpect": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/input-group.tsx"],
			"linter": {
				"rules": { "nursery": { "useTailwindShorthandClasses": "off" } }
			}
		},
		{
			"includes": ["src/lib/notify.ts", "**/*.test.ts", "**/*.test.tsx"],
			"linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
		},
		{
			"includes": ["**/*.test.tsx", "src/dev/**"],
			"linter": { "rules": { "style": { "noJsxLiterals": "off" } } }
		},
		{
			"includes": ["src/i18n/locale/*.ts"],
			"linter": { "rules": { "style": { "useFilenamingConvention": "off" } } }
		},
		{
			"includes": ["**/*.css"],
			"linter": { "rules": { "nursery": { "useLayeredStyles": "off" } } }
		},
		{
			"includes": [
				"src/billing/billing-page.tsx",
				"src/settings/connections-page.tsx",
				"src/device/device-link-page.tsx"
			],
			"linter": { "rules": { "nursery": { "useReactCompiler": "off" } } }
		},
		{
			"includes": ["vite.config.ts", "playwright.config.ts", "scripts/**", "**/*.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noGlobalDirnameFilename": "off"
					},
					"style": { "noProcessEnv": "off" },
					"suspicious": { "noConsole": "off" }
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"src/test-setup.ts",
				"**/__mocks__/**",
				"e2e/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noGlobalDirnameFilename": "off"
					},
					"style": { "noProcessEnv": "off", "useConsistentTestIt": "off" },
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off",
						"useAwait": "off",
						"noShadow": "off",
						"noEmptyBlockStatements": "off",
						"noPlaywrightWaitForTimeout": "off"
					},
					"performance": { "noDelete": "off" },
					"nursery": {
						"noUnsafeTypeAssertion": "off",
						"useReactCompiler": "off"
					}
				}
			}
		}
	]
}
