{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!public",
			"!**/playwright-report",
			"!**/test-results",
			"!bun.lock",
			"!**/*.md"
		]
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": {
				"noAccidentalBitwiseOperators": "error",
				"noArgumentsCallerOrCallee": "error",
				"noArraySortForMinMax": "error",
				"noAstroConflictingSetDirectives": "error",
				"noAstroSetHtmlDirective": "error",
				"noAwaitInPromiseMethods": "error",
				"noBooleanSortComparator": "error",
				"noBunModules": "error",
				"noConsoleSpaces": "error",
				"noDoubleComparison": "error",
				"noDuplicateMapKeys": "error",
				"noExtendNative": "error",
				"noImpliedEval": "error",
				"noInvalidFileInputAccept": "error",
				"noInvalidPropertyInitValue": "error",
				"noInvalidRemoveEventListener": "error",
				"noInvalidThis": "error",
				"noJsRestrictedProperties": "error",
				"noJsonUnsafeValues": "error",
				"noLateEventControl": "error",
				"noMagicArrayFlatDepth": "error",
				"noMismatchedMapKey": "error",
				"noMisplacedListElements": "error",
				"noMissingScssInterpolation": "error",
				"noMissingThrow": "error",
				"noNegationInEqualityCheck": "error",
				"noNestedSwitch": "error",
				"noNewRequire": "error",
				"noNonScalableViewport": "error",
				"noObjectConstructor": "error",
				"noObjectLiteralComparison": "error",
				"noObsoleteAttributes": "error",
				"noObsoleteTags": "error",
				"noOctal": "error",
				"noPathConcat": "error",
				"noPlaywrightUnsafeReferences": "error",
				"noPseudoElementInFunctionalPseudoClass": "error",
				"noReactObjectTypeAsDefaultProp": "error",
				"noRestrictedDependencies": "error",
				"noReturnInFinally": "error",
				"noSelfNestedLayer": "error",
				"noShortTimeValues": "error",
				"noSinglePromiseInPromiseMethods": "error",
				"noSvelteAddEventListener": "error",
				"noSvelteAtDebugTags": "error",
				"noSvelteAtHtmlTags": "error",
				"noSvelteBindValueOnCheckableInputs": "error",
				"noSvelteClassDirective": "error",
				"noSvelteExportLet": "error",
				"noSvelteInspect": "error",
				"noSvelteInternal": "error",
				"noSvelteLegacyConst": "error",
				"noSvelteObjectInTextMustaches": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"noSvelteUselessDerivedBy": "error",
				"noTanstackQueryRestDestructuring": "error",
				"noUnmodifiedLoopCondition": "error",
				"noUnnecessaryStringTrim": "error",
				"noUnreadableIife": "error",
				"noUnsafeIframeSandbox": "error",
				"noUnsafeTypeAssertion": "error",
				"noUselessAssignment": "error",
				"noUselessAwait": "error",
				"noUselessCall": "error",
				"noUselessDateGetTime": "error",
				"noUselessLengthCheck": "error",
				"noVueBooleanDefault": "error",
				"noVueChildContent": "error",
				"noVueComputedPropertiesInData": "error",
				"noVueDeprecatedConfigKeyCodes": "error",
				"noVueDeprecatedDeleteSet": "error",
				"noVueDeprecatedDestroyedLifecycle": "error",
				"noVueDeprecatedEventsApi": "error",
				"noVueDeprecatedFunctionalTemplate": "error",
				"noVueDeprecatedHtmlElementIs": "error",
				"noVueDeprecatedInlineTemplate": "error",
				"noVueDeprecatedListeners": "error",
				"noVueDeprecatedModelDefinition": "error",
				"noVueDeprecatedPropsDefaultThis": "error",
				"noVueDeprecatedRouterLinkTagProp": "error",
				"noVueDeprecatedScopeAttribute": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueDeprecatedSlotAttribute": "error",
				"noVueDeprecatedSlotScope": "error",
				"noVueDeprecatedVBindSync": "error",
				"noVueDeprecatedVOnNativeModifier": "error",
				"noVueExcessiveProps": "error",
				"noVueLifecycleAfterAwait": "error",
				"noVueLoneTemplate": "error",
				"noVueMixin": "error",
				"noVueMultipleObjectsInClass": "error",
				"noVueMultipleSlotArgs": "error",
				"noVueMutatingProps": "error",
				"noVueRefObjectReactivityLoss": "error",
				"noVueRequiredPropWithDefault": "error",
				"noVueRestrictedCallAfterAwait": "error",
				"noVueRestrictedVOn": "error",
				"noVueRootVIf": "error",
				"noVueShadowNativeEvents": "error",
				"noVueSideEffectsInComputed": "error",
				"noVueTemplateKey": "error",
				"noVueTemplateShadow": "error",
				"noVueTextareaMustache": "error",
				"noVueThisInBeforeRouteEnter": "error",
				"noVueThisInTemplate": "error",
				"noVueUndeclaredDirectives": "error",
				"noVueUndeclaredEmits": "error",
				"noVueUndeclaredProperties": "error",
				"noVueUndeclaredSlots": "error",
				"noVueUnusedEmitDeclarations": "error",
				"noVueUnusedRefs": "error",
				"noVueUselessTemplateAttributes": "error",
				"noVueUselessVBind": "error",
				"noVueVForTemplateKeyOnChild": "error",
				"noVueVHtml": "error",
				"noVueVText": "error",
				"noVueVTextVHtmlOnComponent": "error",
				"noVueWatchAfterAwait": "error",
				"noXorAsExponentiation": "error",
				"noYamlBooleanKeys": "error",
				"noZeroFractions": "error",
				"noZeroLengthUnit": "error",
				"useAccessorPairs": "error",
				"useAstroClientOnlyDirectiveValue": "error",
				"useBetterDomTraversing": "error",
				"useBigintLiterals": "error",
				"useConsistentBlockLang": "error",
				"useConsistentHeadingLevel": "error",
				"useConsistentJsonFileRead": "error",
				"useConsistentObjectKeys": "error",
				"useConsistentUnicodeBom": "error",
				"useControlLabel": "error",
				"useFlatMathMinMax": "error",
				"useIteratorZip": "error",
				"useLayeredStyles": "error",
				"useMatchingFunctionName": "error",
				"useMathAbs": "error",
				"useMathTrunc": "error",
				"useModernMathApis": "error",
				"useNamedLayer": "error",
				"useObjectFromEntries": "error",
				"usePackageJsonValidCpu": "error",
				"usePackageJsonValidEngines": "error",
				"usePromiseRejectErrors": "error",
				"useReactCompiler": "error",
				"useReactNativeValidPlatformColors": "error",
				"useSetSize": "error",
				"useSingleTopLevelHeading": "error",
				"useSvelteEventDispatcherTypes": "error",
				"useSvelteKitResolve": "error",
				"useSvelteKitRuneImports": "error",
				"useSvelteReactiveClasses": "error",
				"useSvelteRequireEachKey": "error",
				"useSvelteShorthandDirective": "error",
				"useSvelteStoreInitialValue": "error",
				"useTailwindShorthandClasses": "error",
				"useTanstackQueryInfiniteQueryPropertyOrder": "error",
				"useTopLevelHeading": "error",
				"useUnaryMinus": "error",
				"useVueBaseImport": "error",
				"useVueBlockOrder": "error",
				"useVueBooleanPropTypeFirst": "error",
				"useVueComponentIs": "error",
				"useVueComputedPropertyReturn": "error",
				"useVueConsistentBooleanPropStyle": "error",
				"useVueConsistentDefineEmitsDeclaration": "error",
				"useVueConsistentEventHyphenation": "error",
				"useVueConsistentPropNameCasing": "error",
				"useVueConsistentVForDelimiter": "error",
				"useVueConsistentVSlotStyle": "error",
				"useVueDefaultExport": "error",
				"useVueDefaultProp": "error",
				"useVueDefineOptions": "error",
				"useVueDefinePropsDestructuring": "error",
				"useVueEmitValidator": "error",
				"useVueEmitsValidatorReturn": "error",
				"useVueMacroVariableName": "error",
				"useVueMatchingComponentFileName": "error",
				"useVueOneComponentPerFile": "error",
				"useVuePropTypeConstructor": "error",
				"useVueRenderReturn": "error",
				"useVueSeparateStaticClass": "error",
				"useVueSingleEventPayload": "error",
				"useVueSlotNameCasing": "error",
				"useVueSlotsAsFunctions": "error",
				"useVueTemplateRef": "error",
				"useVueToggleInsideTransition": "error",
				"useVueTypedObjectProps": "error",
				"useVueTypedProps": "error",
				"useVueTypedRef": "error",
				"useVueVModel": "error",
				"useVueVOnExact": "error",
				"useVueValidAttributeName": "error",
				"useVueValidDefaultProp": "error",
				"useVueValidDefineEmits": "error",
				"useVueValidDefineOptions": "error",
				"useVueValidDefineProps": "error",
				"useVueValidNextTick": "error",
				"useVueValidVIs": "error",
				"useVueValidVMemo": "error",
				"useVueValidVModel": "error",
				"useVueValidVShow": "error",
				"useVueValidVSlot": "error",
				"useWhileLoopCondition": "error"
			},
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": {
							"level": "error",
							"options": {
								"inputComponents": ["Checkbox", "Input", "RadioGroupItem", "Textarea"]
							}
						}
					},
					"complexity": {
						"noExcessiveLinesPerFunction": "off",
						"useMaxParams": "off",
						"noExcessiveCognitiveComplexity": "off",
						"noForEach": "off",
						"useRegexpTest": "off"
					},
					"correctness": {
						"useQwikValidLexicalScope": "off",
						"noSolidDestructuredProps": "off",
						"noInvalidPositionAtImportRule": "off",
						"noUndeclaredDependencies": "off",
						"useImageSize": "off",
						"useUniqueElementIds": "off",
						"noReactNativeRawText": "off",
						"noComponentHookFactories": "off"
					},
					"performance": {
						"useTopLevelRegex": "off",
						"useSolidForComponent": "off",
						"noImgElement": "off",
						"noJsxPropsBind": "off",
						"noAwaitInLoops": "off",
						"noBarrelFile": "off",
						"noNamespaceImport": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off",
						"noSecrets": "off"
					},
					"style": {
						"useNamingConvention": "off",
						"noMagicNumbers": "off",
						"noDefaultExport": "off",
						"noImplicitBoolean": "off",
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"sonner": {
										"importNames": ["toast"],
										"message": "Use notify() from @/lib/notify: it only accepts translated text (UIText)."
									}
								}
							}
						},
						"noJsxLiterals": {
							"level": "error",
							"options": {
								"allowedStrings": [
									"&nbsp;",
									"·",
									"••••",
									"&#10003;",
									"−",
									"/",
									"&times;",
									"×",
									"↗",
									"↳",
									"?",
									"#",
									"---",
									"x",
									"H",
									"404",
									".md",
									"type",
									"Engram",
									"Engram Vault Sync",
									"AMEX",
									"PayPal",
									"GPay",
									"github.com/engram-app/Engram",
									"support@engram.page",
									"ENGRAM_TELEMETRY=false",
									"engram_••••••"
								]
							}
						},
						"noTernary": "off",
						"noHexColors": "off",
						"useGlobalThis": "off",
						"noContinue": "off",
						"noExcessiveClassesPerFile": "off",
						"noExcessiveLinesPerFile": "off",
						"noExportedImports": "off",
						"noIncrementDecrement": "off",
						"noNestedTernary": "off",
						"noNonNullAssertion": "off",
						"noParameterProperties": "off",
						"useComponentExportOnlyModules": "off",
						"useConsistentMemberAccessibility": "off",
						"useConsistentMethodSignatures": "off",
						"noInlineStyles": "off",
						"useDomQuerySelector": "off",
						"useTestHooksOnTop": "off",
						"useThisInClassMethods": "off",
						"useUnicodeRegex": "off"
					},
					"suspicious": {
						"noReactSpecificProps": "off",
						"noAlert": "off",
						"noConsole": {
							"level": "error",
							"options": {
								"allow": ["error", "warn"]
							}
						},
						"noSkippedTests": "off",
						"noUnnecessaryConditions": "off",
						"noConditionalExpect": "off",
						"noDuplicateSelectors": "off",
						"useBaseline": "off",
						"useExpect": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/input-group.tsx"],
			"linter": {
				"rules": {
					"nursery": {
						"useTailwindShorthandClasses": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/notify.ts", "**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.tsx", "src/dev/**"],
			"linter": {
				"rules": {
					"style": {
						"noJsxLiterals": "off"
					}
				}
			}
		},
		{
			"includes": ["src/i18n/locale/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"nursery": {
						"useLayeredStyles": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/billing/billing-page.tsx",
				"src/settings/connections-page.tsx",
				"src/device/device-link-page.tsx"
			],
			"linter": {
				"rules": {
					"nursery": {
						"useReactCompiler": "off"
					}
				}
			}
		},
		{
			"includes": ["vite.config.ts", "playwright.config.ts", "scripts/**", "**/*.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noGlobalDirnameFilename": "off"
					},
					"style": {
						"noProcessEnv": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"src/test-setup.ts",
				"**/__mocks__/**",
				"e2e/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noGlobalDirnameFilename": "off"
					},
					"style": {
						"noProcessEnv": "off",
						"useConsistentTestIt": "off"
					},
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off",
						"useAwait": "off",
						"noShadow": "off",
						"noEmptyBlockStatements": "off",
						"noPlaywrightWaitForTimeout": "off"
					},
					"performance": {
						"noDelete": "off"
					},
					"nursery": {
						"noUnsafeTypeAssertion": "off",
						"useReactCompiler": "off"
					}
				}
			}
		}
	]
}
